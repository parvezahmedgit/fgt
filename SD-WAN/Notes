SD WAN LAB:

TATA:
int f0/1
ip address dhcp
ip nat outside
no sh

int f0/0
ip add 192.168.100.2 255.255.255.0
ip nat inside
no sh

access-list 100 permit ip any any

ip nat inside source list 100 interface f0/1 overload


Airtel:
int f0/1
ip address dhcp
ip nat outside
no sh

int f0/0
ip add 192.168.200.2 255.255.255.0
ip nat inside
no sh

access-list 100 permit ip any any

ip nat inside source list 100 interface f0/1 overload


FGT:
config system interface
    edit "port1"
        set vdom "root"
        set ip 192.168.100.1 255.255.255.0
        set allowaccess ping https ssh snmp http
        set type physical
        set snmp-index 1
    next
    edit "port2"
        set vdom "root"
        set ip 192.168.200.1 255.255.255.0
        set allowaccess ping https ssh http
        set type physical
        set snmp-index 2
    next
    edit "port3"
        set vdom "root"
        set ip 10.1.1.100 255.255.255.0
        set allowaccess ping https ssh snmp http
        set type physical
        set description "Mgmedit"
        set snmp-index 3
    next
    edit "port4"
        set vdom "root"
        set ip 10.10.10.1 255.255.255.0
        set allowaccess ping
        set type physical
        set snmp-index 4
    next
    end

    config system sdwan
    set status enable
    config zone
        edit "virtual-wan-link"
        next
    end
    config members
        edit 1
            set interface "port1"
            set gateway 192.168.100.2
        next
        edit 2
            set interface "port2"
            set gateway 192.168.200.2
        next
    end

config health-check
edit "ping"
            set server "4.2.2.2"
            set members 1 2
        next
    end
    config service
        edit 1
            set name "icmp"
            set mode priority
            set dst "4.2.2.2"
            set src "all"
            set health-check "ping"
            set priority-members 2
            set status disable
        next
        edit 2
            set name "8.8.8.8"
            set mode priority
            set dst "8.8.8.8"
            set src "all"
            set health-check "ping"
            set priority-members 1
            set status disable
        next
    end
end

config router static
    edit 1
        set distance 1
        set sdwan-zone "virtual-wan-link"
    next
end

config firewall policy
    edit 1
        set name "sd-wan-all"
        set uuid 8066ab90-2d77-51f0-f9c8-77a04661a74a
        set srcintf "port4"
        set dstintf "virtual-wan-link"
        set action accept
        set srcaddr "all"
        set dstaddr "all"
        set schedule "always"
        set service "ALL"
        set logtraffic all
        set nat enable
    next
end
