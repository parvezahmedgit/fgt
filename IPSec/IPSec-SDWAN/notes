ADB # show router static 
config router static
    edit 1
        set dst 10.10.10.0 255.255.255.0
        set distance 1
        set sdwan-zone "sd-wan-zone"
    next
    edit 2
        set dst 10.10.10.0 255.255.255.0
        set distance 250
        set blackhole enable
    next
end

ADB # show firewall policy 
config firewall policy
    edit 1
        set name "ipsec-outbond"
        set uuid dd9ffc16-2869-51f0-b62c-81182cb374a2
        set srcintf "port2"
        set dstintf "sd-wan-zone"
        set action accept
        set srcaddr "local"
        set dstaddr "remote"
        set schedule "always"
        set service "ALL"
        set logtraffic disable
    next
    edit 2
        set name "ipsec-in"
        set uuid e2014062-2869-51f0-2fbe-cccd6df08d3a
        set srcintf "sd-wan-zone"
        set dstintf "port2"
        set action accept
        set srcaddr "remote"
        set dstaddr "local"
        set schedule "always"
        set service "ALL"
        set logtraffic disable
    next 
end

