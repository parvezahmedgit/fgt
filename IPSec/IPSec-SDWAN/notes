Site-ADB
config system global
set alias "ADB"
set hostname "ADB"
set timezone 47
end
config system interface
edit "port1"
set mode static
set ip 1.1.1.2 255.255.255.0
set allowaccess ping https ssh snmp http 
next
edit "port2"
set mode static
set ip 20.20.20.1 255.255.255.0
set allowaccess ping 
next
edit "port3"
set mode static
set ip 10.1.1.101 255.255.255.0
set allowaccess ping https ssh snmp http
set description "Mgmt"
next
edit "port4"
set mode static
set ip 192.168.1.102 255.255.255.0
set allowaccess ping https ssh snmp http
next
end


config system sdwan
edit "sd-wan-zone"
        next
config members
        edit 1
            set interface "hyd-a"
            set zone "sd-wan-zone"
            set source 20.20.20.1
        next
        edit 2
            set interface "hyd-b"
            set zone "sd-wan-zone"
            set source 20.20.20.1
        next
        edit "ping"
            set server "10.10.10.1"
            set members 2 1
        next
        config service
        edit 1
            set name "best_qulity_link"
            set mode priority
            set dst "remote"
            set src "local"
            set health-check "ping"
            set priority-members 2 1
            set priority-zone "sd-wan-zone"
        next
        end

