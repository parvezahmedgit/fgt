
HYD-FW:
config system global
    set alias "HYD"
    set hostname "HYD"
    set timezone 47
end


config system interface
    edit "port1"
        set mode static
        set ip 1.1.1.1 255.255.255.0
        set allowaccess ping https ssh snmp http telnet fgfm radius-acct probe-response fabric ftm speed-test
        next

        edit "port2"
        set mode static
        set ip 10.10.10.1 255.255.255.0
        set allowaccess ping 
        next

        edit "port3"
        set mode static
        set ip 10.1.1.100 255.255.255.0
        set allowaccess ping https ssh snmp http telnet fgfm radius-acct probe-response fabric ftm speed-test
        set description "Mgmt"
    	next


    	edit "port4"
        set mode static
        set ip 192.168.1.101 255.255.255.0
        set allowaccess ping https ssh snmp http telnet fgfm radius-acct probe-response fabric ftm speed-test
        next

HYD-SW:
conf t
ip default-gateway 10.10.10.1
hostname HYD-SW
do wr


PC1:
ip 10.10.10.2 255.255.255.0 10.10.10.1
save



********************
ADB-FW:
config system global
    set alias "ADB"
    set hostname "ADB"
    set timezone 47
end
config system interface
    edit "port1"
        set mode static
        set ip 1.1.1.2 255.255.255.0
        set allowaccess ping https ssh snmp http 
        next
        edit "port2"
        set mode static
        set ip 20.20.20.1 255.255.255.0
        set allowaccess ping 
        next
        edit "port3"
        set mode static
        set ip 10.1.1.101 255.255.255.0
        set allowaccess ping https ssh snmp http
        set description "Mgmt"
    	next
    	edit "port4"
        set mode static
        set ip 192.168.1.101 255.255.255.0
        set allowaccess ping https ssh snmp http
        next
        end
ADB-SW:
conf t
ip default-gateway 20.20.20.1
hostname ADB-SW
do wr

PC02:
ip 20.20.20.2 255.255.255.0 20.20.20.1
save